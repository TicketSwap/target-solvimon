# Solvimon credentials for target-solvimon.
# Copy this file to .env and fill in your actual values.
#
# Only connection settings belong here: environment variables win over the config in
# meltano.yml, so anything set here silently overrides a pipeline's own mapping.

# Required: API key with the METER_DATA.INGEST permission, sent as X-API-KEY
TARGET_SOLVIMON_API_KEY=your_api_key_here

# Optional: API base URL. Defaults to the test environment.
# Use https://api.solvimon.com to write billable events.
TARGET_SOLVIMON_API_URL=https://test.api.solvimon.com

# Optional: batch ingest endpoint version (v1 or v2)
# TARGET_SOLVIMON_API_VERSION=v1

# Optional: bearer token, sent as the Authorization header
# TARGET_SOLVIMON_AUTH_TOKEN=

# Optional: platform ID, sent as the x-platform-id header
# TARGET_SOLVIMON_PLATFORM_ID=

# Optional: HTTP behaviour (seconds / attempts)
# TARGET_SOLVIMON_TIMEOUT=60
# TARGET_SOLVIMON_MAX_RETRIES=5
# TARGET_SOLVIMON_BACKOFF_FACTOR=2

# Optional: record -> event mapping. Prefer setting these per pipeline in
# meltano.yml or in your target config file.
# TARGET_SOLVIMON_DERIVE_EVENT_ID=true
# TARGET_SOLVIMON_EVENT_ID_FIELD=id
# TARGET_SOLVIMON_EVENT_REFERENCE_FIELD=reference
# TARGET_SOLVIMON_EVENT_REFERENCE=
# TARGET_SOLVIMON_EVENT_TIMESTAMP_FIELD=timestamp
# TARGET_SOLVIMON_CUSTOMER_REFERENCE_FIELD=customer_reference
# TARGET_SOLVIMON_CUSTOMER_REFERENCE=
# TARGET_SOLVIMON_EXTRA_FIELDS=passthrough
# TARGET_SOLVIMON_METER_REFERENCE=tickets
# TARGET_SOLVIMON_METER_PROPERTIES='["country", "event_name"]'
# TARGET_SOLVIMON_METER_VALUES='{"collected_payment": {"amount_field": "collected_payment", "currency_field": "currency"}}'
